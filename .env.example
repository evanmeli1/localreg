# Copy to .env and fill in real values. .env is gitignored.
# Supabase ▸ Project Settings ▸ API

# Safe to expose — sent to the browser. Constrained by RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET. Bypasses RLS completely. Server-side only — never prefix with
# NEXT_PUBLIC_ and never import lib/supabase-admin.js into a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Placeholder gate for /admin. Checked server-side in the admin API routes.
# Replace with real session auth before launch.
ADMIN_PASSWORD=change-me
