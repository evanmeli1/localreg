# Copy to .env and fill in real values. .env is gitignored.
# Supabase ▸ Project Settings ▸ API

# Safe to expose — sent to the browser. Constrained by RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET. Bypasses RLS completely. Server-side only — never prefix with
# NEXT_PUBLIC_ and never import lib/supabase-admin.js into a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The admin login password. Compared in constant time by /api/admin/login,
# which then issues a signed session cookie. Make it long and random.
ADMIN_PASSWORD=change-me

# Signs the admin session cookie. Generate with: openssl rand -base64 32
# No fallback exists in code — if this is unset, admin login fails closed.
SESSION_SECRET=generate-me
